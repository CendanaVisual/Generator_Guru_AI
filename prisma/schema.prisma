generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  documents Document[]
}

model Document {
  id        String   @id @default(cuid())
  title     String
  type      String   // e.g. "Modul Ajar", "LKPD"
  grade     String   // e.g. "Fase A"
  content   String   // The HTML result
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}
